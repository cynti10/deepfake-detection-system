# Flask runtime
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Upload size limit in bytes (default 50MB)
MAX_CONTENT_LENGTH=52428800

# Gunicorn tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Background adversarial pipeline
ADV_PIPELINE_ENABLED=true
ADV_PIPELINE_INTERVAL_SEC=120
ADV_POOL_MIN_SAMPLES=500
ADV_FINE_TUNE_EPOCHS=4
ADV_MAX_AUC_DROP=0.005

# Image adversarial generation + fine-tune
ADV_IMAGE_SOURCE_DIRS=/home/cynthia/deepfake-detection-system/backend/adversarial_seed/image_real,/home/cynthia/deepfake-detection-system/backend/adversarial_seed/image_fake
ADV_IMAGE_POOL_DIR=
ADV_IMAGE_GAN_COMMAND=
ADV_IMAGE_GEN_PER_CYCLE=32
ADV_IMAGE_MAX_ATTEMPTS_FACTOR=4
ADV_IMAGE_FGSM_EPS=0.010
ADV_IMAGE_FINE_TUNE_LR=0.000002

# Audio adversarial generation + fine-tune
ADV_AUDIO_SOURCE_DIRS=/home/cynthia/deepfake-detection-system/backend/adversarial_seed/audio_real,/home/cynthia/deepfake-detection-system/backend/adversarial_seed/audio_fake
ADV_AUDIO_POOL_DIR=
ADV_AUDIO_GAN_COMMAND=
ADV_AUDIO_GEN_PER_CYCLE=32
ADV_AUDIO_MAX_ATTEMPTS_FACTOR=4
ADV_AUDIO_FGSM_EPS=0.003
ADV_AUDIO_FINE_TUNE_LR=0.000001

# Video scaffold (auto-runs once model and source dirs are available)
ADV_VIDEO_SOURCE_DIRS=
ADV_VIDEO_POOL_DIR=
ADV_VIDEO_GAN_COMMAND=

# Multimodal metadata forensics
FORENSICS_METADATA_ENABLED=true

# Cryptographic evidence signing (HMAC-SHA256)
EVIDENCE_HMAC_SECRET=deepfake-smoke-hmac-secret

# Edge deployment export profile
EDGE_EXPORT_ONNX_ENABLED=true
EDGE_EXPORT_TFLITE_ENABLED=false
